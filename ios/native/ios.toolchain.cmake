# 极简 iOS 交叉编译工具链。仅在 macOS + Xcode 上使用。
# 用 CMake 内置的 iOS 平台支持，产出 arm64 静态库（不签名）。
set(CMAKE_SYSTEM_NAME iOS)
set(CMAKE_OSX_ARCHITECTURES arm64)
set(CMAKE_OSX_SYSROOT iphoneos)

# 部署目标可由调用方通过 -DCYIME_IOS_DEPLOYMENT_TARGET 覆盖（默认 26.0）。
if(NOT DEFINED CYIME_IOS_DEPLOYMENT_TARGET)
  set(CYIME_IOS_DEPLOYMENT_TARGET "26.0")
endif()
set(CMAKE_OSX_DEPLOYMENT_TARGET "${CYIME_IOS_DEPLOYMENT_TARGET}" CACHE STRING "" FORCE)

set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)

# 交叉编译时很多 check_* 会尝试链接可执行文件；改为只编译静态库，避免误判。
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(CMAKE_POSITION_INDEPENDENT_CODE ON)

# 静态库不签名。
set(CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED "NO")
set(CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_REQUIRED "NO")
