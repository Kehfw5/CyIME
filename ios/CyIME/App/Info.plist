	<string>用于拍照识字。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>用于从相册选择图片识字。</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>用于和电脑同步剪贴板。</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.cyletix.cyime</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cyime</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
